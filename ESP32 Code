void startNtp() {
  configTime(
    GMT_OFFSET_SEC,
    DAYLIGHT_OFFSET_SEC,
    "pool.ntp.org",
    "time.google.com",
    "time.nist.gov"
  );

  Serial.println("[NTP] Synchronization started");
}

void setupWiFi() {
  wifiSSID = preferences.getString("wifi", "");
  wifiPassword = preferences.getString("pass", "");

  setupPortalRoutes();

  if (wifiSSID.length() == 0) {
    startPortal();
    return;
  }

  WiFi.mode(WIFI_STA);
  WiFi.setAutoReconnect(true);
  WiFi.begin(wifiSSID.c_str(), wifiPassword.c_str());

  Serial.print("[WiFi] Connecting");

  unsigned long startAttempt = millis();

  while (
    WiFi.status() != WL_CONNECTED &&
    millis() - startAttempt < 15000
  ) {
    Serial.print(".");
    delay(250);
  }

  Serial.println();

  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("[WiFi] Connection failed -> setup portal");
    startPortal();
  } else {
    Serial.print("[WiFi] Connected, IP ");
    Serial.println(WiFi.localIP());
  }
}

void maintainNetwork() {
  if (WiFi.status() == WL_CONNECTED) {
    wifiLostSince = 0;

    if (!wifiWasConnected) {
      wifiWasConnected = true;
      lastNtpRetry = millis();
      startNtp();
    }

    // ยังไม่ได้เวลา -> ลองขอใหม่ทุก 30 วินาที
    if (!isTimeReady() && millis() - lastNtpRetry >= 30000) {
      lastNtpRetry = millis();
      startNtp();
    }

    if (portalActive) {
      stopPortal();
    }

    if (!otaStarted) {
      setupOTA();
    }

    return;
  }

  // ---- ยังไม่เชื่อมต่อ ----
  wifiWasConnected = false;

  if (otaStarted) {
    ArduinoOTA.end();
    otaStarted = false;
  }

  if (wifiLostSince == 0) {
    wifiLostSince = millis();
  }

  // ไม่เคยตั้ง WiFi -> เปิด AP ทันที / เคยตั้งแต่ต่อไม่ได้ -> เปิดหลัง 20 วินาที
  if (
    !portalActive &&
    (
      wifiSSID.length() == 0 ||
      millis() - wifiLostSince >= WIFI_PORTAL_DELAY_MS
    )
  ) {
    Serial.println("[WiFi] Not connected -> starting setup portal");
    startPortal();
  }

  // ลองต่อ WiFi เดิมเรื่อยๆ แม้ AP เปิดอยู่ (เว้นไว้ตอนมีคนต่อ AP เพื่อตั้งค่า)
  bool someoneConfiguring =
    portalActive && WiFi.softAPgetStationNum() > 0;

  if (
    wifiSSID.length() > 0 &&
    !someoneConfiguring &&
    millis() - lastWiFiRetry >= 15000
  ) {
    lastWiFiRetry = millis();

    Serial.println("[WiFi] Retrying connection...");

    WiFi.disconnect(false, false);
    WiFi.begin(wifiSSID.c_str(), wifiPassword.c_str());
  }
}

// =====================================================
// 12. BLYNK CONNECTION
// =====================================================

void maintainBlynk() {
  if (WiFi.status() != WL_CONNECTED) {
    return;
  }

  if (Blynk.connected()) {
    Blynk.run();
    return;
  }

  // ไม่พยายามเชื่อมใหม่ขณะปั๊มกำลังทำงาน (การเชื่อมต่อบล็อกได้ถึง 0.5 วินาที)
  if (machineState != MACHINE_IDLE) {
    return;
  }

  if (millis() - lastBlynkRetry >= 10000) {
    lastBlynkRetry = millis();

    Serial.println("[Blynk] Connecting...");
    Blynk.connect(500);
  }
}

// ถ้า Cloud ไม่มีค่า config ให้ส่งค่าในเครื่องขึ้นไป
void synchronizeLocalConfigIfNeeded() {
  if (
    Blynk.connected() &&
    !cloudConfigReceived &&
    millis() - cloudSyncStarted >= 5000
  ) {
    Serial.println("[Blynk] No cloud config -> uploading local config");

    Blynk.virtualWrite(V5, serializeConfig());

    cloudConfigReceived = true;
  }
}

// =====================================================
// 13. SEQUENCER
// =====================================================

void startCurrentPulse() {
  ScheduleConfig& s = schedules[activeSchedule];

  uint32_t durationMs =
    (uint32_t)((currentPump == 0) ? s.tenths26 : s.tenths27) * 100UL;

  setPump(currentPump, true);

  machineState = MACHINE_PUMP_ON;
  machineDeadline = millis() + durationMs;

  Serial.print("[PUMP] GPIO");
  Serial.print(currentPump == 0 ? PUMP1_PIN : PUMP2_PIN);
  Serial.print(" ON for ");
  Serial.print(durationMs / 1000.0, 1);
  Serial.println(" seconds");
}

void scheduleNextPulse() {
  ScheduleConfig& s = schedules[activeSchedule];

  if (s.gapSeconds == 0) {
    startCurrentPulse();
    return;
  }

  allPumpsOff();

  machineState = MACHINE_GAP;
  machineDeadline = millis() + (uint32_t)s.gapSeconds * 1000UL;
}

bool startSequence(uint8_t scheduleIndex, bool manual) {
  if (scheduleIndex >= SCHEDULE_COUNT) {
    return false;
  }

  if (machineState != MACHINE_IDLE || otaInProgress) {
    setStatus("Cannot start: system busy");
    return false;
  }

  ScheduleConfig& s = schedules[scheduleIndex];

  if (!manual && !s.enabled) {
    return false;
  }

  activeSchedule = scheduleIndex;

  firstPump = s.reverseOrder ? 1 : 0;
  currentPump = firstPump;

  repetitionCount = 0;

  allPumpsOff();

  setStatus(
    String(manual ? "Manual test started: Schedule "
                  : "Automatic schedule started: Schedule ") +
    String(scheduleIndex + 1)
  );

  startCurrentPulse();

  return true;
}

void stopAll() {
  allPumpsOff();

  machineState = MACHINE_IDLE;
  pendingMask = 0;
  repetitionCount = 0;

  setStatus("STOP activated - all pumps OFF");
}

void finishSequence() {
  allPumpsOff();

  machineState = MACHINE_IDLE;

  setStatus(String("Schedule ") + String(activeSchedule + 1) + " completed");
}

void processSequencer() {
  if (machineState == MACHINE_IDLE) {
    return;
  }

  if ((int32_t)(millis() - machineDeadline) < 0) {
    return;
  }

  if (machineState == MACHINE_GAP) {
    startCurrentPulse();
    return;
  }

  // MACHINE_PUMP_ON หมดเวลา
  allPumpsOff();

  repetitionCount++;

  ScheduleConfig& s = schedules[activeSchedule];

  uint16_t targetRepetitions =
    (currentPump == 0) ? s.repetitions26 : s.repetitions27;

  if (repetitionCount >= targetRepetitions) {
    if (currentPump == firstPump) {
      currentPump = 1 - firstPump;
      repetitionCount = 0;
    } else {
      finishSequence();
      return;
    }
  }

  scheduleNextPulse();
}

// =====================================================
// 14. AUTOMATIC SCHEDULER
// =====================================================

uint32_t makeDateValue(const tm& t) {
  return
    (uint32_t)(t.tm_year + 1900) * 10000UL +
    (uint32_t)(t.tm_mon + 1) * 100UL +
    (uint32_t)t.tm_mday;
}

void checkSchedules() {
  static unsigned long lastCheckMs = 0;

  if (millis() - lastCheckMs < 1000) {
    return;
  }

  lastCheckMs = millis();

  if (!isTimeReady()) {
    return;
  }

  time_t now = time(nullptr);

  tm t;
  localtime_r(&now, &t);

  uint32_t today = makeDateValue(t);

  uint32_t nowSec =
    (uint32_t)t.tm_hour * 3600UL +
    (uint32_t)t.tm_min * 60UL +
    (uint32_t)t.tm_sec;

  // Monday = bit 0 ... Sunday = bit 6
  uint8_t dayBit = (t.tm_wday == 0) ? 6 : (t.tm_wday - 1);

  for (uint8_t i = 0; i < SCHEDULE_COUNT; i++) {
    ScheduleConfig& s = schedules[i];

    if (!s.enabled) continue;
    if (lastRunDate[i] == today) continue;
    if ((s.dayMask & (1U << dayBit)) == 0) continue;

    uint32_t scheduledSec =
      (uint32_t)s.hour * 3600UL + (uint32_t)s.minute * 60UL;

    if (
      nowSec >= scheduledSec &&
      nowSec < scheduledSec + RUN_WINDOW_SEC
    ) {
      saveLastRunDate(i, today);

      pendingMask |= (1U << i);

      setStatus(String("Schedule ") + String(i + 1) + " queued");
    }
  }
}

void startNextPendingSchedule() {
  if (machineState != MACHINE_IDLE || otaInProgress) {
    return;
  }

  for (uint8_t i = 0; i < SCHEDULE_COUNT; i++) {
    uint8_t bit = (1U << i);

    if (pendingMask & bit) {
      pendingMask &= ~bit;

      if (!schedules[i].enabled) {
        continue;
      }

      startSequence(i, false);
      return;
    }
  }
}

// =====================================================
// 15. MANUAL TEST
// =====================================================

void startManualTest(int scheduleNumber) {
  if (scheduleNumber < 1 || scheduleNumber > SCHEDULE_COUNT) {
    setStatus("Invalid manual schedule");
    return;
  }

  if (machineState != MACHINE_IDLE || pendingMask != 0 || otaInProgress) {
    setStatus("Manual test rejected: system busy");
    return;
  }

  startSequence(scheduleNumber - 1, true);
}

// =====================================================
// 16. BLYNK CALLBACKS
// =====================================================

BLYNK_CONNECTED() {
  Serial.println("[Blynk] Connected");

  cloudConfigReceived = false;
  cloudSyncStarted = millis();

  Blynk.syncVirtual(V5);

  setStatus("Blynk connected - syncing config");
}

// V5: เก็บ/ซิงค์ config
BLYNK_WRITE(V5) {
  const char* received = param.asStr();

  String incoming = received ? String(received) : "";

  incoming.trim();

  cloudConfigReceived = true;

  if (incoming.length() == 0) {
    Blynk.virtualWrite(V5, serializeConfig());

    Serial.println("[Blynk] Local config uploaded");
    return;
  }

  handleConfigPayload(incoming, "V5", false);
}

// V40: คำสั่ง STOP / TEST:n / CFG:<config>
BLYNK_WRITE(V40) {
  const char* received = param.asStr();

  String command = received ? String(received) : "";

  command.trim();

  Serial.print("[Blynk] Command: ");
  Serial.println(command);

  if (command == "STOP") {
    stopAll();
    return;
  }

  if (command.startsWith("TEST:")) {
    startManualTest(command.substring(5).toInt());
    return;
  }

  if (command.startsWith("CFG:")) {
    handleConfigPayload(command.substring(4), "V40", true);
    return;
  }

  if (command.length() > 0) {
    setStatus("Unknown command");
  }
}

// V41 เป็น output อย่างเดียว

// =====================================================
// 17. SETUP / LOOP
// =====================================================

void setup() {
  Serial.begin(115200);

  // ตั้งระดับ OFF ก่อนเปิดเอาต์พุต
  digitalWrite(PUMP1_PIN, RELAY_OFF);
  digitalWrite(PUMP2_PIN, RELAY_OFF);

  pinMode(PUMP1_PIN, OUTPUT);
  pinMode(PUMP2_PIN, OUTPUT);

  allPumpsOff();

  preferences.begin("feedcfg", false);

  loadConfig();

  Blynk.config(BLYNK_AUTH_TOKEN);

  blynkTimer.setInterval(5000L, publishStatus);

  setupWiFi();

  Serial.println();
  Serial.println("=================================");
  Serial.println("ESP32 Feeding Scheduler");
  Serial.println("GPIO26 = Pump 1, GPIO27 = Pump 2");
  Serial.println("4 schedules, min pump time 0.1 s");
  Serial.println("ArduinoOTA enabled (no password)");
  Serial.println("=================================");

  setStatus("System ready - pumps OFF");
}

void loop() {
  // ระหว่าง OTA ไม่ทำงานอื่น
  if (otaInProgress) {
    ArduinoOTA.handle();
    return;
  }

  handlePortal();

  maintainNetwork();

  maintainBlynk();

  blynkTimer.run();

  synchronizeLocalConfigIfNeeded();

  processSequencer();

  checkSchedules();

  startNextPendingSchedule();

  if (otaStarted && WiFi.status() == WL_CONNECTED) {
    ArduinoOTA.handle();
  }
}
