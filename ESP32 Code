void setupPortalRoutes() {
  portalServer.on("/", HTTP_GET, []() {
    portalServer.send_P(200, "text/html", PORTAL_HTML);
  });

  portalServer.on("/save", HTTP_POST, []() {
    String newSSID = portalServer.arg("ssid");
    String newPassword = portalServer.arg("password");

    newSSID.trim();

    if (newSSID.length() == 0) {
      portalServer.send(400, "text/plain", "SSID is required");
      return;
    }

    preferences.putString("wifi", newSSID);
    preferences.putString("pass", newPassword);

    wifiSSID = newSSID;
    wifiPassword = newPassword;

    portalServer.send(
      200,
      "text/html",
      "<h2>WiFi saved.</h2><p>ESP32 is connecting.</p>"
    );

    WiFi.disconnect(false, false);
    WiFi.mode(WIFI_AP_STA);
    WiFi.begin(wifiSSID.c_str(), wifiPassword.c_str());

    lastWiFiRetry = millis();
  });

  portalServer.onNotFound([]() {
    portalServer.sendHeader("Location", "/", true);
    portalServer.send(302, "text/plain", "");
  });
}

void startPortal() {
  if (portalActive) return;

  WiFi.mode(WIFI_AP_STA);
  WiFi.softAP(AP_SSID, AP_PASSWORD);

  dnsServer.start(53, "*", WiFi.softAPIP());
  portalServer.begin();

  portalActive = true;

  Serial.println("[WiFi] Setup portal started");
  Serial.print("[WiFi] SSID: ");
  Serial.println(AP_SSID);
  Serial.print("[WiFi] IP: ");
  Serial.println(WiFi.softAPIP());
}

void stopPortal() {
  if (!portalActive) return;

  // ถ้ามีคนต่ออยู่ รอให้หน้า "WiFi saved" ส่งถึงมือถือก่อน
  if (WiFi.softAPgetStationNum() > 0) {
    delay(1500);
  }

  dnsServer.stop();
  portalServer.stop();

  WiFi.softAPdisconnect(true);
  WiFi.mode(WIFI_STA);

  portalActive = false;

  Serial.println("[WiFi] Setup portal stopped");
}

void handlePortal() {
  if (!portalActive) return;

  dnsServer.processNextRequest();
  portalServer.handleClient();
}

// =====================================================
// 10. OTA (ไม่มีรหัสผ่าน)
// =====================================================

void setupOTA() {
  if (otaStarted || WiFi.status() != WL_CONNECTED) {
    return;
  }

  ArduinoOTA.setHostname(OTA_HOSTNAME);

  ArduinoOTA.onStart([]() {
    // ปิดปั๊มและหยุดงานทั้งหมดทันทีที่เริ่มอัปเดต
    otaInProgress = true;

    allPumpsOff();
    machineState = MACHINE_IDLE;
    pendingMask = 0;

    systemStatus = "OTA update started";

    Serial.println("[OTA] Update started - pumps OFF");
  });

  ArduinoOTA.onEnd([]() {
    Serial.println("[OTA] Update completed, restarting...");
  });

  ArduinoOTA.onProgress([](unsigned int progress, unsigned int total) {
    if (total == 0) return;

    static unsigned long lastPrint = 0;

    if (millis() - lastPrint >= 500) {
      lastPrint = millis();

      Serial.printf("[OTA] Progress: %u%%\n", (progress * 100U) / total);
    }
  });

  ArduinoOTA.onError([](ota_error_t error) {
    otaInProgress = false;

    Serial.printf("[OTA] Error: %u\n", (unsigned int)error);

    systemStatus = "OTA failed";
  });

  ArduinoOTA.begin();

  otaStarted = true;

  Serial.print("[OTA] Ready, host ");
  Serial.print(OTA_HOSTNAME);
  Serial.print(", IP ");
  Serial.println(WiFi.localIP());
}

