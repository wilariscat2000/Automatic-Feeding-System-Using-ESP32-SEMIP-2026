bool isTimeReady() {
  return time(nullptr) > 1700000000;
}

String timeInfoText() {
  if (!isTimeReady()) {
    return "NTP: not synced";
  }

  time_t now = time(nullptr);

  tm t;
  localtime_r(&now, &t);

  char buf[32];
  strftime(buf, sizeof(buf), "%d/%m %H:%M:%S", &t);

  return String(buf);
}

void publishStatus() {
  Serial.print("[TIME] ");
  Serial.println(timeInfoText());

  if (Blynk.connected()) {
    Blynk.virtualWrite(V41, systemStatus + " | " + timeInfoText());
  }
}

void setStatus(const String& message) {
  systemStatus = message;

  Serial.print("[STATUS] ");
  Serial.println(systemStatus);

  publishStatus();
}

// =====================================================
// 6. PUMP CONTROL
// =====================================================

void allPumpsOff() {
  digitalWrite(PUMP1_PIN, RELAY_OFF);
  digitalWrite(PUMP2_PIN, RELAY_OFF);
}

void setPump(uint8_t pump, bool turnOn) {
  allPumpsOff();

  if (!turnOn) {
    return;
  }

  digitalWrite(
    pump == 0 ? PUMP1_PIN : PUMP2_PIN,
    RELAY_ON
  );
}

// =====================================================
// 7. CONFIG TEXT FORMAT
//    "HH:MM,days,enabled,order,sec26,rep26,sec27,rep27,gap|..." (4 แถว)
// =====================================================

// แยกข้อความด้วยตัวคั่น คืนจำนวนส่วนที่ได้ (ถ้าเกิน maxParts คืน maxParts+1)
int splitString(
  const String& text,
  char separator,
  String* parts,
  int maxParts
) {
  int count = 0;
  int start = 0;

  while (count < maxParts) {
    int idx = text.indexOf(separator, start);

    if (idx < 0) {
      parts[count++] = text.substring(start);
      return count;
    }

    parts[count++] = text.substring(start, idx);
    start = idx + 1;
  }

  return maxParts + 1;
}

bool parseUInt(String s, uint32_t& out) {
  s.trim();

  if (s.length() == 0 || s.length() > 5) {
    return false;
  }

  for (size_t i = 0; i < s.length(); i++) {
    if (!isDigit(s[i])) {
      return false;
    }
  }

  out = (uint32_t)s.toInt();

  return true;
}

// "10", "2.5", "0.1" -> หน่วย 0.1 วินาที
bool parseTenths(String s, uint32_t& out) {
  s.trim();

  if (s.length() == 0) {
    return false;
  }

  int dot = s.indexOf('.');

  String whole = (dot < 0) ? s : s.substring(0, dot);
  String frac  = (dot < 0) ? "" : s.substring(dot + 1);

  if (
    whole.length() == 0 ||
    whole.length() > 4 ||
    frac.length() > 1
  ) {
    return false;
  }

  uint32_t w = 0;
  uint32_t f = 0;

  if (!parseUInt(whole, w)) {
    return false;
  }

  if (frac.length() == 1 && !parseUInt(frac, f)) {
    return false;
  }

  out = w * 10 + f;

  return true;
}

void formatTenths(char* buf, size_t size, uint16_t tenths) {
  if (tenths % 10 == 0) {
    snprintf(buf, size, "%u", (unsigned)(tenths / 10));
  } else {
    snprintf(
      buf,
      size,
      "%u.%u",
      (unsigned)(tenths / 10),
      (unsigned)(tenths % 10)
    );
  }
}

String serializeConfig() {
  String output;
  output.reserve(260);

  for (uint8_t i = 0; i < SCHEDULE_COUNT; i++) {
    const ScheduleConfig& s = schedules[i];

    char t26[12];
    char t27[12];
    char row[96];

    formatTenths(t26, sizeof(t26), s.tenths26);
    formatTenths(t27, sizeof(t27), s.tenths27);

    snprintf(
      row,
      sizeof(row),
      "%02u:%02u,%u,%u,%u,%s,%u,%s,%u,%u",
      (unsigned)s.hour,
      (unsigned)s.minute,
      (unsigned)s.dayMask,
      (unsigned)(s.enabled ? 1 : 0),
      (unsigned)(s.reverseOrder ? 1 : 0),
      t26,
      (unsigned)s.repetitions26,
      t27,
      (unsigned)s.repetitions27,
      (unsigned)s.gapSeconds
    );

    output += row;

    if (i < SCHEDULE_COUNT - 1) {
      output += "|";
    }
  }

  return output;
}

// ตรวจและแปลงข้อความ -> out (ไม่แตะ schedules จนกว่าจะผ่านทั้งหมด)
bool parseConfig(String payload, ScheduleConfig* out) {
  payload.trim();

  String rows[SCHEDULE_COUNT];

  if (splitString(payload, '|', rows, SCHEDULE_COUNT) != SCHEDULE_COUNT) {
    return false;
  }

  for (uint8_t i = 0; i < SCHEDULE_COUNT; i++) {
    String f[9];

    if (splitString(rows[i], ',', f, 9) != 9) {
      return false;
    }

    for (uint8_t j = 0; j < 9; j++) {
      f[j].trim();
    }

    if (f[0].length() != 5 || f[0][2] != ':') {
      return false;
    }

    uint32_t hh, mm, days, en, order, t26, r26, t27, r27, gap;

    if (
      !parseUInt(f[0].substring(0, 2), hh) ||
      !parseUInt(f[0].substring(3, 5), mm) ||
      !parseUInt(f[1], days) ||
      !parseUInt(f[2], en) ||
      !parseUInt(f[3], order) ||
      !parseTenths(f[4], t26) ||
      !parseUInt(f[5], r26) ||
      !parseTenths(f[6], t27) ||
      !parseUInt(f[7], r27) ||
      !parseUInt(f[8], gap)
    ) {
      return false;
    }

    if (
      hh > 23 ||
      mm > 59 ||
      days > 127 ||
      en > 1 ||
      order > 1 ||
      t26 < MIN_PUMP_TENTHS || t26 > MAX_PUMP_TENTHS ||
      r26 < MIN_REPETITIONS || r26 > MAX_REPETITIONS ||
      t27 < MIN_PUMP_TENTHS || t27 > MAX_PUMP_TENTHS ||
      r27 < MIN_REPETITIONS || r27 > MAX_REPETITIONS ||
      gap > MAX_GAP_SECONDS
    ) {
      return false;
    }

    out[i].hour = hh;
    out[i].minute = mm;
    out[i].dayMask = days;
    out[i].enabled = (en == 1);
    out[i].reverseOrder = (order == 1);
    out[i].tenths26 = t26;
    out[i].repetitions26 = r26;
    out[i].tenths27 = t27;
    out[i].repetitions27 = r27;
    out[i].gapSeconds = gap;
  }

  return true;
}

// สรุปสั้นๆ สำหรับแสดงที่ป้ายสถานะ: + = เปิดใช้งาน, - = ปิด
String configSummary() {
  String s;

  for (uint8_t i = 0; i < SCHEDULE_COUNT; i++) {
    char buf[24];

    snprintf(
      buf,
      sizeof(buf),
      " S%u %02u:%02u%s",
      (unsigned)(i + 1),
      (unsigned)schedules[i].hour,
      (unsigned)schedules[i].minute,
      schedules[i].enabled ? "+" : "-"
    );

    s += buf;
  }

  return s;
}

// =====================================================
// 8. STORAGE
// =====================================================

void saveLastRunDate(uint8_t index, uint32_t value) {
  char key[8];

  snprintf(key, sizeof(key), "run%u", index);

  lastRunDate[index] = value;

  preferences.putUInt(key, value);
}

void loadConfig() {
  const uint8_t defaultHours[SCHEDULE_COUNT] = { 8, 12, 18, 22 };

  for (uint8_t i = 0; i < SCHEDULE_COUNT; i++) {
    schedules[i] = ScheduleConfig();
    schedules[i].hour = defaultHours[i];
  }

  String saved = preferences.getString("cfg", "");

  if (saved.length() > 0) {
    ScheduleConfig candidate[SCHEDULE_COUNT];

    if (parseConfig(saved, candidate)) {
      for (uint8_t i = 0; i < SCHEDULE_COUNT; i++) {
        schedules[i] = candidate[i];
      }

      Serial.println("[CFG] Loaded from flash");
    } else {
      Serial.println("[CFG] Saved config invalid -> defaults");
    }
  } else {
    Serial.println("[CFG] No saved config -> defaults");
  }

  for (uint8_t i = 0; i < SCHEDULE_COUNT; i++) {
    char key[8];

    snprintf(key, sizeof(key), "run%u", i);

    lastRunDate[i] = preferences.getUInt(key, 0);
  }

  Serial.print("[CFG]");
  Serial.println(configSummary());
}

void applyConfig(const ScheduleConfig* candidate) {
  for (uint8_t i = 0; i < SCHEDULE_COUNT; i++) {
    bool changed =
      candidate[i].hour != schedules[i].hour ||
      candidate[i].minute != schedules[i].minute ||
      candidate[i].dayMask != schedules[i].dayMask ||
      candidate[i].enabled != schedules[i].enabled;

    schedules[i] = candidate[i];

    // เปลี่ยนเวลา/วัน/เปิด-ปิด -> ล้างสถานะ "รันไปแล้ววันนี้"
    if (changed) {
      saveLastRunDate(i, 0);
    }
  }

  preferences.putString("cfg", serializeConfig());
}

// รับ config จาก Blynk (V5 หรือ V40)
bool handleConfigPayload(
  String payload,
  const char* source,
  bool echoToCloud
) {
  Serial.print("[CFG] Received via ");
  Serial.print(source);
  Serial.print(": ");
  Serial.println(payload);

  ScheduleConfig candidate[SCHEDULE_COUNT];

  if (!parseConfig(payload, candidate)) {
    setStatus(String("Config REJECTED (") + source + ")");
    return false;
  }

  applyConfig(candidate);

  if (echoToCloud && Blynk.connected()) {
    Blynk.virtualWrite(V5, serializeConfig());
  }

  setStatus(String("Config OK (") + source + ")" + configSummary());

  return true;
}

